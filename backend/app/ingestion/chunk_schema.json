{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LegalChunk",
  "type": "object",
  "required": ["text", "code", "chapter", "article", "article_number", "chunk_index", "point", "chunk_type", "source"],
  "properties": {
    "text": { "type": "string", "minLength": 1 },
    "code": { "type": "string", "minLength": 1 },
    "chapter": { "type": "string" },
    "article": { "type": "string" },
    "article_number": { "type": "string", "pattern": "^\\d+(-\\d+)?$" },
    "chunk_index": { "type": "integer", "minimum": 0 },
    "point": { "type": "string" },
    "chunk_type": { "type": "string", "enum": ["norm", "article_full", "preamble", "other"] },
    "source": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}

# Required
OPENAI_API_KEY=

# Tracing (optional: without keys tracing is off)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=local

# Qdrant (defaults point at the local docker-compose Qdrant)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=qorgau_legal_corpus

# Accounts. Locally: SQLite and no sign-in (a local admin user).
# DATABASE_URL=sqlite:///backend/data/qorgau.db
# AUTH_REQUIRED=1                   # require a signed-in user (production)
# BACKEND_JWT_SECRET=               # same value as the frontend's
# ADMIN_EMAILS=you@example.com      # comma-separated; see /admin, no daily limit
# DAILY_QUESTIONS_PER_USER=20
# DAILY_BUDGET_USD=5
# ALLOWED_ORIGINS=http://localhost:3000

# Experiments: any node model can be swapped without code changes, e.g.
# GENERATOR_MODEL=gpt-5.5
# AGENT_RERANK=true
